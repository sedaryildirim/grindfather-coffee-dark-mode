---
const featuredReview = {
  name: 'Robyn McDowall',
  via: 'Google',
  quote: 'Our puppy\'s favourite coffee spot. The coffee tastes amazing and the service is perfection.',
};

const secondaryReviews = [
  {
    name: 'Ben Brigode',
    via: 'Google',
    quote: 'Amazing coffee and drinks! Not to mention the jam welsh cakes! Super friendly owner and very accommodating. Highly recommend.',
  },
  {
    name: 'Sarah Roberts',
    via: 'Google',
    quote: 'What a fabulous guy serving great coffee! Visited twice now and both times had first class coffee. My daughter said the matcha was the best she\'d ever tasted.',
  },
  {
    name: 'Sophie Anna',
    via: 'Google',
    quote: 'Great service, lovely guy and has a lot of knowledge on his craft. He has attended a lot of events in his coffee van.',
  },
  {
    name: 'Jayenna Smith',
    via: 'Local Guide · Google',
    quote: 'Lovely coffee to fuel a workout, and great smoothies for post-workout recovery.',
  },
];

const eventReview = {
  name: 'Henry',
  via: 'Local Guide · Google',
  quote: 'Fantastic experience having Grindfather at our event, and would absolutely use again!',
};
---

<!-- Events — standalone section for nav discoverability -->
<section class="events-section" id="events" aria-labelledby="events-heading">
  <div class="events-section__inner">
    <p class="contact__label">EVENTS &amp; PRIVATE BOOKINGS</p>
    <div class="events__body">
      <h2 class="events__headline" id="events-heading">
        WE BRING THE<br /><span class="events__accent">BAR</span> TO YOU.
      </h2>
      <div class="events__right">
        <p class="events__text">
          Private events, weddings, pop-ups. From a 30-person corporate breakfast to a 300-guest
          wedding. Wherever you need great coffee, we'll set up.
        </p>
        <ul class="events__types" role="list">
          <li>Private Events</li>
          <li>Weddings</li>
          <li>Pop-ups</li>
        </ul>
        <dl class="events__logistics">
          <div class="events__logistic">
            <dt>CAPACITY</dt>
            <dd>30 to 300 guests</dd>
          </div>
          <div class="events__logistic">
            <dt>INCLUDED</dt>
            <dd>Full setup included</dd>
          </div>
          <div class="events__logistic">
            <dt>LEAD TIME</dt>
            <dd>4 weeks minimum</dd>
          </div>
        </dl>
        <a
          href="mailto:thegrindfathercoffee@gmail.com?subject=Event%20Booking%20Enquiry&body=Name%3A%0A%0AEvent%20type%20(wedding%20%2F%20corporate%20%2F%20pop-up%20%2F%20other)%3A%0A%0ADate%3A%0A%0AGuest%20count%3A%0A%0AMessage%3A"
          class="events__cta"
          aria-label="Send event booking enquiry email"
        >SEND ENQUIRY ↗</a>
        <p class="events__cta-note">
          We usually reply within 48 hours. Or reach us at
          <a href="mailto:thegrindfathercoffee@gmail.com">thegrindfathercoffee@gmail.com</a>
          or <a href="https://instagram.com/the_grindfather_coffee" target="_blank" rel="noopener noreferrer">DM on Instagram ↗</a>
        </p>

        <blockquote class="events__proof">
          <p class="events__proof-quote">"{eventReview.quote}"</p>
          <footer class="events__proof-footer">
            <span class="review__name">{eventReview.name}</span>
            <span class="review__via">{eventReview.via}</span>
          </footer>
        </blockquote>
      </div>
    </div>
  </div>
</section>

<!-- Contact info + reviews -->
<section class="contact" id="contact" aria-label="Contact">
  <div class="contact__inner">

    <!-- Contact info -->
    <div class="contact__info" data-reveal>
      <h2 class="contact__label">GET IN TOUCH</h2>
      <dl class="contact__details">
        <div class="contact__detail">
          <dt>EMAIL</dt>
          <dd><a href="mailto:thegrindfathercoffee@gmail.com">thegrindfathercoffee@gmail.com</a></dd>
        </div>
        <div class="contact__detail">
          <dt>PHONE</dt>
          <dd><a href="tel:+447464339434">+44 7464 339434</a></dd>
        </div>
        <div class="contact__detail">
          <dt>INSTAGRAM</dt>
          <dd><a href="https://instagram.com/the_grindfather_coffee" target="_blank" rel="noopener noreferrer">@the_grindfather_coffee ↗</a></dd>
        </div>
        <div class="contact__detail">
          <dt>FACEBOOK</dt>
          <dd><a href="https://facebook.com/p/The-Grindfather-Coffee-61575198692256" target="_blank" rel="noopener noreferrer">The Grindfather Coffee ↗</a></dd>
        </div>
      </dl>
    </div>

    <!-- Reviews -->
    <div class="reviews" data-reveal data-delay="1">
      <p class="reviews__rating" aria-label="5.0 stars on Google">
        ★★★★★ <span>5.0 · Google</span>
      </p>

      <blockquote class="review--featured">
        <p class="review--featured__quote">"{featuredReview.quote}"</p>
        <footer class="review--featured__footer">
          <span class="review__name">{featuredReview.name}</span>
          <span class="review__via">{featuredReview.via}</span>
        </footer>
      </blockquote>

      <ul class="reviews__secondary" role="list">
        {secondaryReviews.map((r, i) => (
          <li class:list={["review--secondary", {
            "review--secondary--full": secondaryReviews.length % 2 !== 0 && i === secondaryReviews.length - 1
          }]}>
            <blockquote class="review__quote"><p>"{r.quote}"</p></blockquote>
            <footer class="review__footer">
              <span class="review__name">{r.name}</span>
              <span class="review__via">{r.via}</span>
            </footer>
          </li>
        ))}
      </ul>
    </div>

  </div>
</section>

<style>
  /* ── Shared label ── */
  .contact__label {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--brick-light);
    text-transform: uppercase;
    margin-bottom: 2rem;
  }

  /* ── Events section (standalone) ── */
  .events-section {
    background-color: var(--ink);
    padding: 8rem 2.5rem;
    border-bottom: 1px solid var(--ink-border);
  }

  .events-section__inner {
    max-width: 72rem;
    margin-inline: auto;
  }

  .events__body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
    border-top: 1px solid var(--ink-border);
    padding-top: 2.5rem;
  }

  .events__headline {
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 5.25rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--paper);
  }

  .events__accent {
    color: var(--brick);
  }

  .events__right {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .events__text {
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.7;
    color: var(--paper-muted-dark);
    max-width: 46ch;
  }

  .events__types {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid var(--ink-border);
  }

  .events__types li {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--ink-border);
  }

  .events__logistics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1px solid var(--ink-border);
  }

  .events__logistic {
    padding: 1rem 0;
    border-bottom: 1px solid var(--ink-border);
    padding-right: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .events__logistic dt {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .events__logistic dd {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--paper-dim);
    line-height: 1.4;
  }

  @media (max-width: 640px) {
    .events__logistics {
      grid-template-columns: 1fr 1fr;
    }

    .events__logistic:last-child {
      grid-column: span 2;
    }
  }

  .events__cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--paper);
    padding-bottom: 0.25rem;
    border-bottom: 1px solid var(--brick);
    cursor: pointer;
    transition: border-color 250ms var(--ease-out-quart), transform 160ms var(--ease-out-quart);
    width: fit-content;
  }

  @media (hover: hover) {
    .events__cta:hover {
      border-color: var(--brick-light);
    }
  }

  .events__cta:active {
    opacity: 0.7;
    transform: scale(0.97);
  }

  .events__cta-note {
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--paper-dim);
    line-height: 1.5;
    margin-top: -0.75rem;
  }

  .events__cta-note a {
    color: var(--paper-faint);
    transition: color 200ms var(--ease-out-quart);
  }

  @media (hover: hover) {
    .events__cta-note a:hover {
      color: var(--paper);
    }
  }

  /* Event social proof quote */
  .events__proof {
    border-top: 1px solid var(--ink-border);
    padding-top: 1.5rem;
    margin-top: -0.25rem;
  }

  .events__proof-quote {
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.65;
    color: var(--paper-dim);
    font-style: normal;
    margin-bottom: 0.875rem;
  }

  .events__proof-footer {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  /* ── Contact section ── */
  .contact {
    background-color: var(--ink);
    padding: 8rem 2.5rem 10rem;
  }

  .contact__inner {
    max-width: 72rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* Reviews */
  .reviews {
    border-top: 1px solid var(--ink-border);
    padding-top: 6rem;
    margin-top: 6rem;
  }

  .reviews__rating {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--brick-light);
    letter-spacing: 0.04em;
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .reviews__rating span {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--ink-muted);
    font-weight: 400;
  }

  /* Featured review */
  .review--featured {
    border-top: 1px solid var(--ink-border);
    border-bottom: 1px solid var(--ink-border);
    padding: 2.5rem 0;
    margin-bottom: 2.5rem;
    max-width: 62ch;
  }

  .review--featured__quote {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 400;
    line-height: 1.45;
    color: var(--paper);
    font-style: normal;
    margin-bottom: 1.5rem;
  }

  .review--featured__footer {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  /* Secondary reviews */
  .reviews__secondary {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
  }

  .review--secondary {
    border-top: 1px solid var(--ink-border);
    padding: 1.375rem 0;
    padding-right: 3rem;
  }

  .review--secondary:nth-child(even) {
    padding-right: 0;
    padding-left: 3rem;
    border-left: 1px solid var(--ink-border);
  }

  .review--secondary--full {
    grid-column: span 2;
    padding-right: 0;
    border-left: none;
  }

  .review--secondary--full:nth-child(even) {
    padding-left: 0;
    border-left: none;
  }

  .review__quote {
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.65;
    color: var(--paper-dim);
    font-style: normal;
    margin-bottom: 1rem;
    max-width: 46ch;
  }

  .review__quote p {
    margin: 0;
  }

  .review--secondary--full .review__quote {
    max-width: 58ch;
  }

  .review__footer {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .review__name {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--paper);
  }

  .review__via {
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    color: var(--ink-muted);
    text-transform: uppercase;
  }

  /* Contact details */
  .contact__details {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    border-top: 1px solid var(--ink-border);
  }

  .contact__detail {
    padding: 1.375rem 0;
    border-bottom: 1px solid var(--ink-border);
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .contact__detail:nth-child(odd) {
    padding-right: 3rem;
    border-right: 1px solid var(--ink-border);
  }

  .contact__detail:nth-child(even) {
    padding-left: 3rem;
  }

  .contact__detail dt {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .contact__detail dd {
    font-size: 0.9375rem;
    font-weight: 400;
    color: var(--paper);
  }

  .contact__detail dd a {
    cursor: pointer;
    transition: color 200ms var(--ease-out-quart);
  }

  @media (hover: hover) {
    .contact__detail dd a:hover {
      color: var(--paper);
    }
  }

  /* ── Responsive ── */
  @media (max-width: 860px) {
    .events__body {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 640px) {
    .events-section {
      padding: 5rem 1.25rem;
    }

    .contact {
      padding: 5rem 1.25rem 7rem;
    }

    .reviews {
      padding-top: 4rem;
      margin-top: 4rem;
    }

    .review--featured {
      padding: 2rem 0;
      max-width: none;
    }

    .reviews__secondary {
      grid-template-columns: 1fr;
    }

    .review--secondary {
      padding-right: 0;
    }

    .review--secondary:nth-child(even) {
      padding-left: 0;
      border-left: none;
    }

    .review--secondary--full {
      grid-column: span 1;
    }

    .contact__details {
      grid-template-columns: 1fr;
    }

    .contact__detail:nth-child(odd) {
      padding-right: 0;
      border-right: none;
    }

    .contact__detail:nth-child(even) {
      padding-left: 0;
    }

  }

  /* ── Scroll-driven animations ── */
  @supports (animation-timeline: scroll()) {
    .contact__info {
      animation: contact-info-in linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 50%;
    }

    @keyframes contact-info-in {
      from { opacity: 0; transform: translateX(-3rem); }
      to   { opacity: 1; transform: none; }
    }

    .events__headline {
      animation: events-rise linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 45%;
    }

    @keyframes events-rise {
      from { opacity: 0; transform: translateY(3.5rem); }
      to   { opacity: 1; transform: none; }
    }

    .events__right {
      animation: events-right-in linear both;
      animation-timeline: view();
      animation-range: entry 15% entry 55%;
    }

    @keyframes events-right-in {
      from { opacity: 0; transform: translateY(2rem); }
      to   { opacity: 1; transform: none; }
    }

    .review--featured {
      animation: review-emerge linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 50%;
    }

    @keyframes review-emerge {
      from { opacity: 0; transform: scale(0.96); }
      to   { opacity: 1; transform: none; }
    }

    .reviews__secondary {
      animation: reviews-secondary-in linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 50%;
    }

    @keyframes reviews-secondary-in {
      from { opacity: 0; transform: translateY(1.5rem); }
      to   { opacity: 1; transform: none; }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact__info,
    .events__headline,
    .events__right,
    .review--featured,
    .reviews__secondary {
      animation: none !important;
      opacity: 1;
      transform: none;
    }
  }
</style>
