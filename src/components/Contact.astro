---
const featuredReview = {
  name: 'Robyn McDowall',
  via: 'Google',
  quote: 'Our puppy\'s favourite coffee spot. The coffee tastes amazing and the service is perfection.',
};

const secondaryReviews = [
  {
    name: 'Ben Brigode',
    via: 'Google',
    quote: 'Amazing coffee and drinks! Not to mention the jam welsh cakes! Super friendly owner and very accommodating. Highly recommend.',
  },
  {
    name: 'Sarah Roberts',
    via: 'Google',
    quote: 'What a fabulous guy serving great coffee! Visited twice now and both times had first class coffee. My daughter said the matcha was the best she\'d ever tasted.',
  },
  {
    name: 'Sophie Anna',
    via: 'Google',
    quote: 'Great service, lovely guy and has a lot of knowledge on his craft. He has attended a lot of events in his coffee van.',
  },
  {
    name: 'Jayenna Smith',
    via: 'Local Guide · Google',
    quote: 'Lovely coffee to fuel a workout, and great smoothies for post-workout recovery.',
  },
];

const eventReview = {
  name: 'Henry',
  via: 'Local Guide · Google',
  quote: 'Fantastic experience having Grindfather at our event, and would absolutely use again!',
};
---

<!-- Events — standalone section for nav discoverability -->
<section class="events-section" id="events" aria-labelledby="events-heading">
  <div class="events-section__inner">
    <p class="contact__label">EVENTS &amp; PRIVATE BOOKINGS</p>
    <div class="events__body">
      <h2 class="events__headline" id="events-heading">
        EVENTS THAT PEOPLE<br /><span class="events__accent">REMEMBER</span>.
      </h2>
      <div class="events__right">
        <p class="events__text">
          Looking for exceptional coffee at your next event?
        </p>
        <p class="events__text">
          The Grindfather provides professional coffee catering for weddings, corporate events, sporting events, festivals and private functions across South Wales.
        </p>
        <p class="events__text">
          Fully self-sufficient or mains connected, we can serve everything from intimate gatherings to large-scale events.
        </p>
        <p class="events__text">
          Our premium mobile coffee setup combines specialty coffee, professional equipment and genuine hospitality to create an experience your guests will remember.
        </p>
        <dl class="events__logistics">
          <div class="events__logistic">
            <dt>INCLUDED</dt>
            <dd>Full setup included</dd>
          </div>
          <div class="events__logistic">
            <dt>LEAD TIME</dt>
            <dd>4 weeks minimum</dd>
          </div>
        </dl>
        <form class="enquiry-form" id="enquiry-form" aria-label="Event booking enquiry">
          <input type="hidden" name="access_key" value="98bb4da2-21ca-4947-96f7-5e66ac2b48e6" />
          <input type="hidden" name="subject" value="Event Booking Enquiry — GRINDFATHER Coffee Co." />
          <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" aria-hidden="true" />

          <div class="enquiry-form__row">
            <div class="enquiry-form__field">
              <label class="enquiry-form__label" for="eq-name">YOUR NAME</label>
              <input class="enquiry-form__input" type="text" id="eq-name" name="name" required autocomplete="name" placeholder="Your name" />
            </div>
            <div class="enquiry-form__field">
              <label class="enquiry-form__label" for="eq-email">EMAIL</label>
              <input class="enquiry-form__input" type="email" id="eq-email" name="email" required autocomplete="email" placeholder="you@example.com" />
            </div>
          </div>

          <div class="enquiry-form__row">
            <div class="enquiry-form__field">
              <label class="enquiry-form__label" for="eq-type">EVENT TYPE</label>
              <select class="enquiry-form__input enquiry-form__select" id="eq-type" name="event_type" required>
                <option value="" disabled selected>Select…</option>
                <option>Wedding</option>
                <option>Corporate</option>
                <option>Pop-up</option>
                <option>Other</option>
              </select>
            </div>
            <div class="enquiry-form__field">
              <label class="enquiry-form__label" for="eq-guests">GUEST COUNT</label>
              <input class="enquiry-form__input" type="number" id="eq-guests" name="guest_count" min="1" placeholder="e.g. 150" />
            </div>
          </div>

          <div class="enquiry-form__field">
            <label class="enquiry-form__label" for="eq-date">EVENT DATE</label>
            <input class="enquiry-form__input" type="text" id="eq-date" name="event_date" placeholder="e.g. June 2026 or 14 Aug 2026" />
          </div>

          <div class="enquiry-form__row">
            <div class="enquiry-form__field">
              <label class="enquiry-form__label" for="eq-start">START TIME</label>
              <input class="enquiry-form__input" type="text" id="eq-start" name="start_time" placeholder="e.g. 09:00" />
            </div>
            <div class="enquiry-form__field">
              <label class="enquiry-form__label" for="eq-finish">FINISH TIME</label>
              <input class="enquiry-form__input" type="text" id="eq-finish" name="finish_time" placeholder="e.g. 17:00" />
            </div>
          </div>

          <div class="enquiry-form__field">
            <label class="enquiry-form__label" for="eq-phone">CONTACT TELEPHONE</label>
            <input class="enquiry-form__input" type="tel" id="eq-phone" name="phone" autocomplete="tel" placeholder="e.g. +44 7700 900000" />
          </div>

          <div class="enquiry-form__field">
            <label class="enquiry-form__label" for="eq-utilities">ACCESS TO ELECTRICITY &amp; WATER</label>
            <select class="enquiry-form__input enquiry-form__select" id="eq-utilities" name="utilities_access">
              <option value="" disabled selected>Select…</option>
              <option value="Both">Both available</option>
              <option value="Electricity only">Electricity only</option>
              <option value="Water only">Water only</option>
              <option value="Neither">Neither — we'll need to discuss</option>
              <option value="Unknown">Not sure yet</option>
            </select>
          </div>

          <div class="enquiry-form__field">
            <label class="enquiry-form__label" for="eq-message">MESSAGE</label>
            <textarea class="enquiry-form__input enquiry-form__textarea" id="eq-message" name="message" rows="3" placeholder="Tell us about your event…"></textarea>
          </div>

          <button type="submit" class="enquiry-form__submit">
            <span class="enquiry-form__submit-label">SEND ENQUIRY</span>
            <svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path d="M2 10L10 2M10 2H4M10 2v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <p class="enquiry-form__note">
            We reply within 48 hours. Or <a href="https://instagram.com/the_grindfather_coffee" target="_blank" rel="noopener noreferrer">DM on Instagram ↗</a>
          </p>
          <p class="enquiry-form__error" id="enquiry-error" aria-live="polite" style="display:none"></p>
        </form>

        <div class="enquiry-success" id="enquiry-success" aria-live="polite" style="display:none">
          <p class="enquiry-success__title">ENQUIRY SENT</p>
          <p class="enquiry-success__text">We'll be in touch within 48 hours.</p>
        </div>

        <blockquote class="events__proof">
          <p class="events__proof-quote">"{eventReview.quote}"</p>
          <footer class="events__proof-footer">
            <span class="review__name">{eventReview.name}</span>
            <span class="review__via">{eventReview.via}</span>
          </footer>
        </blockquote>
      </div>
    </div>
  </div>
</section>

<!-- Contact info + reviews -->
<section class="contact" id="contact" aria-label="Contact">
  <div class="contact__inner">

    <!-- Contact info -->
    <div class="contact__info" data-reveal>
      <h2 class="contact__label">GET IN TOUCH</h2>
      <dl class="contact__details">
        <div class="contact__detail">
          <dt>EMAIL</dt>
          <dd><a href="mailto:thegrindfathercoffee@gmail.com">thegrindfathercoffee@gmail.com</a></dd>
        </div>
        <div class="contact__detail">
          <dt>PHONE</dt>
          <dd><a href="tel:+447464339434">+44 7464 339434</a></dd>
        </div>
        <div class="contact__detail">
          <dt>INSTAGRAM</dt>
          <dd><a href="https://instagram.com/the_grindfather_coffee" target="_blank" rel="noopener noreferrer">@the_grindfather_coffee ↗</a></dd>
        </div>
        <div class="contact__detail">
          <dt>FACEBOOK</dt>
          <dd><a href="https://facebook.com/p/The-Grindfather-Coffee-61575198692256" target="_blank" rel="noopener noreferrer">The Grindfather Coffee ↗</a></dd>
        </div>
      </dl>
    </div>

    <!-- Reviews -->
    <div class="reviews" data-reveal data-delay="1">
      <p class="reviews__rating" aria-label="5.0 stars on Google">
        ★★★★★ <span>5.0 · Google</span>
      </p>

      <blockquote class="review--featured">
        <p class="review--featured__quote">"{featuredReview.quote}"</p>
        <footer class="review--featured__footer">
          <span class="review__name">{featuredReview.name}</span>
          <span class="review__via">{featuredReview.via}</span>
        </footer>
      </blockquote>

      <ul class="reviews__secondary" role="list">
        {secondaryReviews.map((r, i) => (
          <li class:list={["review--secondary", {
            "review--secondary--full": secondaryReviews.length % 2 !== 0 && i === secondaryReviews.length - 1
          }]}>
            <blockquote class="review__quote"><p>"{r.quote}"</p></blockquote>
            <footer class="review__footer">
              <span class="review__name">{r.name}</span>
              <span class="review__via">{r.via}</span>
            </footer>
          </li>
        ))}
      </ul>
    </div>

  </div>
</section>

<style>
  /* ── Shared label ── */
  .contact__label {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--brick-light);
    text-transform: uppercase;
    margin-bottom: 2rem;
  }

  /* ── Events section (standalone) ── */
  .events-section {
    background-color: var(--ink);
    padding: 8rem 2.5rem;
    border-bottom: 1px solid var(--ink-border);
  }

  .events-section__inner {
    max-width: 72rem;
    margin-inline: auto;
  }

  .events__body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
    border-top: 1px solid var(--ink-border);
    padding-top: 2.5rem;
  }

  .events__headline {
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 5.25rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--paper);
  }

  .events__accent {
    color: var(--brick);
  }

  .events__right {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .events__text {
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.7;
    color: var(--paper-muted-dark);
    max-width: 46ch;
  }

  .events__types {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid var(--ink-border);
  }

  .events__types li {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--ink-border);
  }

  .events__logistics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1px solid var(--ink-border);
  }

  .events__logistic {
    padding: 1rem 0;
    border-bottom: 1px solid var(--ink-border);
    padding-right: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .events__logistic dt {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .events__logistic dd {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--paper-dim);
    line-height: 1.4;
  }

  @media (max-width: 640px) {
    .events__logistics {
      grid-template-columns: 1fr 1fr;
    }

    .events__logistic:last-child {
      grid-column: span 2;
    }
  }

  /* Enquiry form */
  .enquiry-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .enquiry-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  @media (max-width: 600px) {
    .enquiry-form__row {
      grid-template-columns: 1fr;
    }
  }

  .enquiry-form__field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .enquiry-form__label {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--ink-muted);
    text-transform: uppercase;
  }

  .enquiry-form__input {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--ink-border);
    color: var(--paper);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 400;
    padding: 0.5rem 0;
    outline: none;
    border-radius: 0;
    -webkit-appearance: none;
    transition: border-color 200ms var(--ease-out-quart);
  }

  .enquiry-form__input:focus-visible {
    outline: 2px solid var(--brick);
    outline-offset: 2px;
    border-radius: 1px;
  }

  .enquiry-form__input::placeholder {
    color: var(--ink-muted);
    opacity: 1;
  }

  .enquiry-form__input:focus {
    border-bottom-color: var(--brick);
  }

  .enquiry-form__select {
    cursor: pointer;
  }

  .enquiry-form__select option {
    background: #060f08;
    color: var(--paper);
  }

  .enquiry-form__textarea {
    resize: vertical;
    min-height: 4.5rem;
    line-height: 1.6;
  }

  .enquiry-form__submit {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    min-height: 44px;
    padding-bottom: 0.25rem;
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--paper);
    background: none;
    border: none;
    border-bottom: 1px solid var(--brick);
    cursor: pointer;
    transition: border-color 250ms var(--ease-out-quart), transform 160ms var(--ease-out-quart), opacity 160ms var(--ease-out-quart);
    margin-top: 0.25rem;
  }

  @media (hover: hover) {
    .enquiry-form__submit:hover {
      border-color: var(--brick-light);
    }
  }

  .enquiry-form__submit:active {
    opacity: 0.7;
    transform: scale(0.97);
  }

  .enquiry-form__submit:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    transform: none;
  }

  .enquiry-form__note {
    font-size: 0.8125rem;
    color: var(--paper-dim);
    line-height: 1.5;
    margin-top: -0.5rem;
  }

  .enquiry-form__error {
    font-size: 0.8125rem;
    color: var(--brick-light);
    line-height: 1.5;
    margin-top: -0.25rem;
  }

  .enquiry-form__note a {
    color: var(--paper-faint);
    transition: color 200ms var(--ease-out-quart);
  }

  @media (hover: hover) {
    .enquiry-form__note a:hover {
      color: var(--paper);
    }
  }

  /* Success state */
  .enquiry-success {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    border-top: 1px solid var(--ink-border);
    padding-top: 1.5rem;
    opacity: 1;
    transition: opacity 400ms var(--ease-out-expo);
  }

  @starting-style {
    .enquiry-success {
      opacity: 0;
    }
  }

  .enquiry-success__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    color: var(--brick);
    line-height: 1;
    letter-spacing: 0.01em;
  }

  .enquiry-success__text {
    font-size: 0.9375rem;
    color: var(--paper-dim);
    line-height: 1.6;
  }

  /* Event social proof quote */
  .events__proof {
    border-top: 1px solid var(--ink-border);
    padding-top: 1.5rem;
    margin-top: -0.25rem;
  }

  .events__proof-quote {
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.65;
    color: var(--paper-dim);
    font-style: normal;
    margin-bottom: 0.875rem;
  }

  .events__proof-footer {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  /* ── Contact section ── */
  .contact {
    background-color: var(--ink);
    padding: 8rem 2.5rem 10rem;
  }

  .contact__inner {
    max-width: 72rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  /* Reviews */
  .reviews {
    border-top: 1px solid var(--ink-border);
    padding-top: 6rem;
    margin-top: 6rem;
  }

  .reviews__rating {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--brick-light);
    letter-spacing: 0.04em;
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .reviews__rating span {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--ink-muted);
    font-weight: 400;
  }

  /* Featured review */
  .review--featured {
    border-top: 1px solid var(--ink-border);
    border-bottom: 1px solid var(--ink-border);
    padding: 2.5rem 0;
    margin-bottom: 2.5rem;
    max-width: 62ch;
  }

  .review--featured__quote {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 400;
    line-height: 1.45;
    color: var(--paper);
    font-style: normal;
    margin-bottom: 1.5rem;
  }

  .review--featured__footer {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  /* Secondary reviews */
  .reviews__secondary {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
  }

  .review--secondary {
    border-top: 1px solid var(--ink-border);
    padding: 1.375rem 0;
    padding-right: 3rem;
  }

  .review--secondary:nth-child(even) {
    padding-right: 0;
    padding-left: 3rem;
    border-left: 1px solid var(--ink-border);
  }

  .review--secondary--full {
    grid-column: span 2;
    padding-right: 0;
    border-left: none;
  }

  .review--secondary--full:nth-child(even) {
    padding-left: 0;
    border-left: none;
  }

  .review__quote {
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.65;
    color: var(--paper-dim);
    font-style: normal;
    margin-bottom: 1rem;
    max-width: 46ch;
  }

  .review__quote p {
    margin: 0;
  }

  .review--secondary--full .review__quote {
    max-width: 58ch;
  }

  .review__footer {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .review__name {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--paper);
  }

  .review__via {
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    color: var(--ink-muted);
    text-transform: uppercase;
  }

  /* Contact details */
  .contact__details {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    border-top: 1px solid var(--ink-border);
  }

  .contact__detail {
    padding: 1.375rem 0;
    border-bottom: 1px solid var(--ink-border);
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .contact__detail:nth-child(odd) {
    padding-right: 3rem;
    border-right: 1px solid var(--ink-border);
  }

  .contact__detail:nth-child(even) {
    padding-left: 3rem;
  }

  .contact__detail dt {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .contact__detail dd {
    font-size: 0.9375rem;
    font-weight: 400;
    color: var(--paper);
  }

  .contact__detail dd a {
    cursor: pointer;
    transition: color 200ms var(--ease-out-quart);
  }

  @media (hover: hover) {
    .contact__detail dd a:hover {
      color: var(--brick-light);
    }
  }

  /* ── Responsive ── */
  @media (max-width: 860px) {
    .events__body {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 640px) {
    .events-section {
      padding: 5rem 1.25rem;
    }

    .contact {
      padding: 5rem 1.25rem 7rem;
    }

    .reviews {
      padding-top: 4rem;
      margin-top: 4rem;
    }

    .review--featured {
      padding: 2rem 0;
      max-width: none;
    }

    .reviews__secondary {
      grid-template-columns: 1fr;
    }

    .review--secondary {
      padding-right: 0;
    }

    .review--secondary:nth-child(even) {
      padding-left: 0;
      border-left: none;
    }

    .review--secondary--full {
      grid-column: span 1;
    }

    .contact__details {
      grid-template-columns: 1fr;
    }

    .contact__detail:nth-child(odd) {
      padding-right: 0;
      border-right: none;
    }

    .contact__detail:nth-child(even) {
      padding-left: 0;
    }

  }

  /* ── Scroll-driven animations ── */
  @supports (animation-timeline: scroll()) {
    .contact__info {
      animation: contact-info-in linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 50%;
    }

    @keyframes contact-info-in {
      from { opacity: 0; transform: translateX(-3rem); }
      to   { opacity: 1; transform: none; }
    }

    .events__headline {
      animation: events-rise linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 45%;
    }

    @keyframes events-rise {
      from { opacity: 0; transform: translateY(3.5rem); }
      to   { opacity: 1; transform: none; }
    }

    .events__right {
      animation: events-right-in linear both;
      animation-timeline: view();
      animation-range: entry 15% entry 55%;
    }

    @keyframes events-right-in {
      from { opacity: 0; transform: translateY(2rem); }
      to   { opacity: 1; transform: none; }
    }

    .review--featured {
      animation: review-emerge linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 50%;
    }

    @keyframes review-emerge {
      from { opacity: 0; transform: scale(0.96); }
      to   { opacity: 1; transform: none; }
    }

    .reviews__secondary {
      animation: reviews-secondary-in linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 50%;
    }

    @keyframes reviews-secondary-in {
      from { opacity: 0; transform: translateY(1.5rem); }
      to   { opacity: 1; transform: none; }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact__info,
    .events__headline,
    .events__right,
    .review--featured,
    .reviews__secondary {
      animation: none !important;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const form = document.getElementById('enquiry-form') as HTMLFormElement | null;
  const successEl = document.getElementById('enquiry-success') as HTMLElement | null;
  const errorEl = document.getElementById('enquiry-error') as HTMLElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const submitBtn = form.querySelector('.enquiry-form__submit') as HTMLButtonElement | null;
    const submitLabel = form.querySelector('.enquiry-form__submit-label');

    if (submitBtn) submitBtn.disabled = true;
    if (submitLabel) submitLabel.textContent = 'SENDING…';

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: new FormData(form),
      });

      const json = await res.json();

      if (json.success) {
        form.style.display = 'none';
        if (successEl) successEl.style.display = 'flex';
      } else {
        throw new Error(json.message || 'Submission failed');
      }
    } catch {
      if (submitLabel) submitLabel.textContent = 'SEND ENQUIRY';
      if (submitBtn) submitBtn.disabled = false;
      if (errorEl) {
        errorEl.textContent = 'Something went wrong. Please email us at thegrindfathercoffee@gmail.com';
        errorEl.style.display = 'block';
      }
    }
  });
</script>
