<section class="about" id="about" aria-labelledby="about-heading">
  <div class="about__image-strip" data-reveal aria-hidden="true">
    <img
      src={`${import.meta.env.BASE_URL}/images/stefan-about-us.webp`}
      alt=""
      width="1600"
      height="900"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="about__inner">
    <div class="about__body">
      <h2 class="about__headline" id="about-heading" data-reveal>
        WE STARTED<br />WITH <span class="about__accent">ONE</span><br />DRUM.
      </h2>
      <div class="about__right" data-reveal data-delay="1">
        <div class="about__text">
          <p>
            We started with a single drum roaster, a notebook of cupping scores, and a stubborn
            belief that great coffee should taste like the place it came from, not like itself.
            A decade on, we still roast every batch by ear.
          </p>
          <p>
            Pulled on a 1969 Faema E61 we restored over two winters. Sourced from farmers we
            know by name and visit each year. Every bag ships within 72 hours of leaving the drum.
          </p>
        </div>

        <dl class="about__facts">
          <div class="about__fact">
            <dt>Direct Trade</dt>
            <dd>Sourced from farmers we know by name and visit each year.</dd>
          </div>
          <div class="about__fact">
            <dt>Roasted to Order</dt>
            <dd>Every bag ships within 72 hours of leaving the drum.</dd>
          </div>
          <div class="about__fact">
            <dt>Community First</dt>
            <dd>Free brew classes and barista trainings for locals every Sunday.</dd>
          </div>
          <div class="about__fact">
            <dt>Made by Hand</dt>
            <dd>Pulled on a 1969 Faema E61 we restored over two winters.</dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>

