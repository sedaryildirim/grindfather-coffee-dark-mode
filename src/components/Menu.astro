---
const coffee = [
  { name: 'ESPRESSO',    price: '2.50', desc: 'A single shot, neat. Today on the grinder: our house blend.' },
  { name: 'MACCHIATO',   price: '3.30', desc: 'Espresso marked with a small spoon of foamed milk.' },
  { name: 'CORTADO',     price: '3.30', desc: 'Equal parts espresso and warm milk. No foam.' },
  { name: 'AMERICANO',   price: '3.50', desc: 'A double shot lengthened with hot water. Long and clean.' },
  { name: 'CAPPUCCINO',  price: '3.80', desc: 'Espresso, steamed milk, dry foam. The classic.' },
  { name: 'FLAT WHITE',  price: '3.80', desc: 'Double ristretto, velvet microfoam. Stronger than a latte.' },
  { name: 'LATTE',       price: '3.80', desc: 'Double shot, steamed milk, a whisper of foam.' },
  { name: 'MOCHA',       price: '4.00', desc: 'Espresso, dark chocolate, steamed milk. Indulgent.' },
  { name: 'FRAPPE',      price: '3.50', desc: 'Iced and blended. Shaken till frothy.' },
  { name: 'ICED COFFEE', price: '4.00', desc: 'Double shot over ice and cold milk. Simple.' },
];

const hotTeas = [
  'Earl Grey',
  'English Breakfast',
  'Berry & Hibiscus',
  'Jade Green',
  'Triple Mint',
];

const icedTeas = [
  'Passion Fruit & Lemon',
  'Peach',
  'Raspberry',
];

const hotDrinks = [
  { name: 'CHAI LATTE',    price: '3.50', desc: 'Spiced black tea, steamed milk, honey on request.' },
  { name: 'HOT CHOCOLATE', price: '3.80', desc: '70% Valrhona, whole milk, sea-salt flake on top.' },
  { name: 'MATCHA LATTE',  price: '4.00', desc: 'Ceremonial-grade matcha, whisked, steamed milk. (Or Turmeric)' },
];
---

<section class="menu" id="menu" aria-labelledby="menu-title">
  <div class="menu__inner">
    <h2 id="menu-title" class="sr-only">Menu</h2>

    <!-- COFFEE -->
    <div class="menu__group" data-reveal>
      <p class="menu__category">COFFEE</p>
      <hr class="menu__rule" />
      <ul class="menu__list" role="list">
        {coffee.map((item, i) => (
          <li class="menu__item menu__item--desc" style={`--i: ${i}`}>
            <div class="menu__item-left">
              <span class="menu__item-name">{item.name}</span>
              <span class="menu__item-desc">{item.desc}</span>
            </div>
            <span class="menu__item-price" aria-label={`£${item.price}`}>£{item.price}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- TEA -->
    <div class="menu__group" data-reveal data-delay="1">
      <p class="menu__category">TEA</p>
      <hr class="menu__rule" />
      <ul class="menu__list" role="list">
        <li class="menu__item menu__item--tea" style="--i: 0">
          <div class="menu__item-left">
            <span class="menu__item-name">HOT TEAS</span>
            <span class="menu__item-desc">Loose-leaf, steeped to order.</span>
            <span class="menu__item-varieties">{hotTeas.join(' · ')}</span>
          </div>
          <span class="menu__item-price" aria-label="£2.50">£2.50</span>
        </li>
        <li class="menu__item menu__item--tea" style="--i: 1">
          <div class="menu__item-left">
            <span class="menu__item-name">ICED TEAS</span>
            <span class="menu__item-desc">Cold-brewed, sweetened lightly. Served over ice.</span>
            <span class="menu__item-varieties">{icedTeas.join(' · ')}</span>
          </div>
          <span class="menu__item-price" aria-label="£3.00">£3.00</span>
        </li>
      </ul>
    </div>

    <!-- HOT DRINKS -->
    <div class="menu__group" data-reveal data-delay="2">
      <p class="menu__category">HOT DRINKS</p>
      <hr class="menu__rule" />
      <ul class="menu__list" role="list">
        {hotDrinks.map((item, i) => (
          <li class="menu__item menu__item--desc" style={`--i: ${i}`}>
            <div class="menu__item-left">
              <span class="menu__item-name">{item.name}</span>
              <span class="menu__item-desc">{item.desc}</span>
            </div>
            <span class="menu__item-price" aria-label={`£${item.price}`}>£{item.price}</span>
          </li>
        ))}
        <li class="menu__item" style={`--i: ${hotDrinks.length}`}>
          <div class="menu__item-left">
            <span class="menu__item-name">FLAVOURED SYRUPS</span>
            <span class="menu__item-desc">Vanilla · Caramel · Hazelnut · Lavender. Add to any drink.</span>
          </div>
          <span class="menu__item-price" aria-label="Add 50p">+£0.50</span>
        </li>
      </ul>
    </div>

    <!-- SHAKES -->
    <div class="menu__group menu__group--shakes" data-reveal data-delay="3">
      <p class="menu__category">SHAKES</p>
      <hr class="menu__rule" />
      <div class="shakes__builder">
        <div class="shakes__header">
          <span class="shakes__title">BUILD YOUR OWN</span>
          <span class="shakes__base-price">FROM £4</span>
        </div>
        <dl class="shakes__tiers">
          <div class="shakes__tier">
            <dt>BASE <span class="shakes__tier-price">included</span></dt>
            <dd>Milk / Non-Dairy · Water · Greek Yogurt · Frozen Banana</dd>
          </div>
          <div class="shakes__tier">
            <dt>INGREDIENTS <span class="shakes__tier-note">pick 3, included</span></dt>
            <dd>Nut Butter · Berries · Dates · Cocoa Powder · Honey / Agave · Oats · Vanilla Extract</dd>
          </div>
          <div class="shakes__tier">
            <dt>PROTEIN <span class="shakes__tier-price">+£1.50</span></dt>
            <dd>Non-Flavoured (Whey) · Vegan Protein</dd>
          </div>
          <div class="shakes__tier shakes__tier--last">
            <dt>EXTRAS <span class="shakes__tier-price">+£1 each</span></dt>
            <dd>Collagen Powder · Shot of Espresso · Matcha · Turmeric</dd>
          </div>
        </dl>
      </div>
    </div>

  </div>
  <p class="menu__allergen">Contains allergens — please ask before ordering.</p>
</section>

<style>
  .menu {
    background-color: var(--ink);
    padding: 8rem 2.5rem;
  }

  .menu__inner {
    max-width: 56rem;
    margin-inline: auto;
  }

  .menu__group {
    margin-bottom: 3.5rem;
  }

  .menu__group:last-of-type {
    margin-bottom: 0;
  }

  .menu__group--shakes {
    margin-top: 2.5rem;
  }

  .menu__category {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--brick-light);
    text-transform: uppercase;
    margin-bottom: 0.875rem;
  }

  .menu__rule {
    border: none;
    border-top: 1px solid var(--ink-border);
    margin-bottom: 0;
  }

  .menu__list {
    list-style: none;
  }

  .menu__item {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 1.5rem;
    padding: 1.125rem 0;
    border-bottom: 1px solid var(--ink-border);
  }

  .menu__item-left {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .menu__item-name {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 900;
    letter-spacing: 0.01em;
    color: var(--paper);
    line-height: 1;
    transition: transform 220ms var(--ease-out-quart);
  }

  @media (hover: hover) {
    .menu__item:hover .menu__item-name {
      transform: translateX(0.5rem);
    }
  }

  .menu__item-desc {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--ink-muted);
    line-height: 1.6;
    max-width: 52ch;
  }

  .menu__item-varieties {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--ink-muted);
    letter-spacing: 0.02em;
    margin-top: 0.125rem;
  }

  .menu__item-price {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--brick-light);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    align-self: start;
    padding-top: 0.125rem;
    transition: color 200ms var(--ease-out-quart);
  }

  @media (hover: hover) {
    .menu__item:hover .menu__item-price {
      color: oklch(78% 0.20 25);
    }
  }

  /* Shakes builder */
  .shakes__builder {
    border-bottom: 1px solid var(--ink-border);
    padding-bottom: 1rem;
  }

  .shakes__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 1.125rem 0 1rem;
    border-bottom: 1px solid var(--ink-border);
  }

  .shakes__title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5.5vw, 4rem);
    font-weight: 900;
    letter-spacing: 0.01em;
    color: var(--paper);
    line-height: 1;
  }

  .shakes__base-price {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--brick-light);
    font-variant-numeric: tabular-nums;
  }

  .shakes__tiers {
    display: flex;
    flex-direction: column;
  }

  .shakes__tier {
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: 1.5rem;
    padding: 1rem 0;
    border-bottom: 1px solid oklch(18% 0.008 155 / 0.5);
    align-items: start;
  }

  .shakes__tier--last {
    border-bottom: none;
  }

  .shakes__tier dt {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .shakes__tier-price {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: oklch(62% 0.008 155);
    text-transform: none;
  }

  .shakes__tier-note {
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: oklch(62% 0.008 155);
    text-transform: none;
  }

  .shakes__tier dd {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 400;
    color: oklch(64% 0.008 155);
    line-height: 1.5;
  }

  .menu__allergen {
    max-width: 56rem;
    margin-inline: auto;
    margin-top: 3rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
    border-top: 1px solid var(--ink-border);
    padding-top: 1.25rem;
  }

  @media (max-width: 640px) {
    .menu {
      padding: 5rem 1.25rem;
    }

    .menu__group {
      margin-bottom: 3rem;
    }

    .shakes__tier {
      grid-template-columns: 1fr;
      gap: 0.375rem;
    }
  }

  /* Scroll-driven: category labels flip in like a sign rotating toward you;
     items slide in from left, staggered by --i index */
  @supports (animation-timeline: scroll()) {
    .menu__group {
      perspective: 800px;
    }

    .menu__category {
      animation: cat-label-flip linear both;
      animation-timeline: view();
      animation-range: entry 0% entry 30%;
      transform-origin: top center;
    }

    @keyframes cat-label-flip {
      from {
        opacity: 0;
        transform: rotateX(-70deg);
      }
      to {
        opacity: 1;
        transform: rotateX(0deg);
      }
    }

    .menu__item {
      animation: item-slide-in linear both;
      animation-timeline: view();
      /* Each item starts animating at a slightly later entry point based on its index */
      animation-range:
        entry calc(var(--i, 0) * 3%)
        entry calc(var(--i, 0) * 3% + 32%);
    }

    @keyframes item-slide-in {
      from { opacity: 0; transform: translateX(-2rem); }
      to   { opacity: 1; transform: none; }
    }

    /* Shakes builder gets its own entry */
    .shakes__builder {
      animation: item-slide-in linear both;
      animation-timeline: view();
      animation-range: entry 5% entry 40%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu__category,
    .menu__item,
    .shakes__builder {
      animation: none !important;
      opacity: 1;
      transform: none;
    }
  }
</style>
