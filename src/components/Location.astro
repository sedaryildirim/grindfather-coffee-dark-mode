<section class="location" id="visit" aria-labelledby="location-heading" data-bg="light">
  <div class="location__inner">
    <div class="location__summary" data-reveal data-delay="1">
      <h2 class="location__headline" id="location-heading">
        <span class="location__accent">TWO</span> HOMES<br />FOR GRINDFATHER<br />COFFEE.
      </h2>
      <p class="location__summary-text">
        Weekday mornings at GymVision in Pentwyn. Sundays at Riverside Market opposite
        the Principality Stadium.
      </p>
    </div>

    <div class="location__grid">

      <!-- GymVision -->
      <div class="location__card" data-reveal data-delay="2">
        <div class="location__card-header">
          <p class="location__venue-label">MON–FRI</p>
          <h3 class="location__venue-name">GYMVISION</h3>
        </div>
        <p class="location__status" aria-live="polite" id="gymvision-status"></p>
        <address class="location__address">
          Avenue Industrial Park<br />
          Croescadarn Close, Pentwyn<br />
          Cardiff CF23 8HE
        </address>
        <p class="location__area-hint">Inside the gym · Pentwyn, NE Cardiff · approx. 15 min from city centre</p>
        <a
          href="https://gymvision.co.uk"
          class="location__site-link"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GymVision website (opens in new tab)"
        >gymvision.co.uk ↗</a>
        <table class="hours-table" aria-label="GymVision opening hours">
          <tbody>
            <tr>
              <th scope="row">MON–FRI</th>
              <td>06:30</td>
              <td>15:00</td>
            </tr>
            <tr class="hours-table__closed">
              <th scope="row">SAT</th>
              <td colspan="2">Closed</td>
            </tr>
            <tr class="hours-table__closed">
              <th scope="row">SUN</th>
              <td colspan="2">See Riverside Market</td>
            </tr>
          </tbody>
        </table>
        <a
          href="https://maps.google.com/?place_id=ChIJLcsP_7kdbkgRX-_iTMjh2uI"
          class="location__map-link"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Get directions to GymVision on Google Maps (opens in new tab)"
        >
          GET DIRECTIONS
          <svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none">
            <path d="M2 10L10 2M10 2H4M10 2v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <!-- Riverside Market -->
      <div class="location__card" data-reveal data-delay="3">
        <div class="location__card-header">
          <p class="location__venue-label">SUNDAY</p>
          <h3 class="location__venue-name">RIVERSIDE MARKET</h3>
        </div>
        <p class="location__status" aria-live="polite" id="riverside-status"></p>
        <address class="location__address">
          Fitzhamon Embankment<br />
          Cardiff CF11 6AN<br />
          Opposite Principality Stadium
        </address>
        <a
          href="https://riversidemarket.org.uk"
          class="location__site-link"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Riverside Market website (opens in new tab)"
        >riversidemarket.org.uk ↗</a>
        <table class="hours-table" aria-label="Riverside Market opening hours">
          <tbody>
            <tr>
              <th scope="row">SUN</th>
              <td>10:00</td>
              <td>14:00</td>
            </tr>
            <tr class="hours-table__closed">
              <th scope="row">MON–SAT</th>
              <td colspan="2">See GymVision</td>
            </tr>
          </tbody>
        </table>
        <a
          href="https://maps.google.com/?place_id=ChIJMUea0K0cbkgRH1GsQUoL64w"
          class="location__map-link"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Get directions to Riverside Market on Google Maps (opens in new tab)"
        >
          GET DIRECTIONS
