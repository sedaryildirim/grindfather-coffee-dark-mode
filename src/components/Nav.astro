  .nav__drawer-links li {
    border-bottom: 1px solid var(--ink-border);
  }

  .nav__drawer-links a {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(3rem, 12vw, 4.5rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.01em;
    color: var(--paper);
