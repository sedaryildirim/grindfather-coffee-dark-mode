      transform: rotate(18deg) scale(1.1);
    }

    .nav__wordmark:hover {
      color: color-mix(in oklch, var(--paper) 70%, transparent);
      letter-spacing: 0.12em;
    }
  }

  /* Desktop nav */
  .nav__links {
    list-style: none;
    display: flex;
    gap: 2.25rem;
  }

  .nav__links a {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--ink-muted);
    transition: color 200ms var(--ease-out-quart);
    position: relative;
    padding-bottom: 3px;
  }

  .nav__links a::after {
    content: '';
