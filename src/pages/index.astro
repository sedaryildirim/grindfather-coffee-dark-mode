---
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Menu from '../components/Menu.astro';
import Location from '../components/Location.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Specialty coffee in Cardiff, Wales. GRINDFATHER Coffee Co. — direct-trade beans roasted to order. Find us weekdays at GymVision, Pentwyn, and Sundays at Riverside Market. Events and private bookings welcome." />
    <meta name="keywords" content="coffee Cardiff, specialty coffee Cardiff, Cardiff coffee shop, coffee van Cardiff, Welsh coffee, GymVision coffee, Riverside Market Cardiff, coffee roaster Cardiff, Cardiff Wales coffee" />
    <meta name="theme-color" content="#000f08" />
    <link rel="canonical" href="https://sedaryildirim.github.io/grindfather-coffee-dark-mode/" />

    <!-- Geo -->
    <meta name="geo.region" content="GB-WLS" />
    <meta name="geo.placename" content="Cardiff, Wales" />
    <meta name="geo.position" content="51.4816;-3.1791" />
    <meta name="ICBM" content="51.4816, -3.1791" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://sedaryildirim.github.io/grindfather-coffee-dark-mode/" />
    <meta property="og:title" content="GRINDFATHER Coffee Co. — Specialty Coffee, Cardiff" />
    <meta property="og:description" content="Direct-trade beans roasted to order in Cardiff, Wales. Weekdays at GymVision, Sundays at Riverside Market. Events and private bookings welcome." />
    <meta property="og:image" content="https://sedaryildirim.github.io/grindfather-coffee-dark-mode/images/grindfather-trailer.webp" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content="GRINDFATHER Coffee Co." />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="GRINDFATHER Coffee Co. — Specialty Coffee, Cardiff" />
    <meta name="twitter:description" content="Direct-trade beans roasted to order in Cardiff, Wales. Weekdays at GymVision, Sundays at Riverside Market." />
    <meta name="twitter:image" content="https://sedaryildirim.github.io/grindfather-coffee-dark-mode/images/grindfather-trailer.webp" />

    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.ico`} />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@900&family=Barlow:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <title>GRINDFATHER Coffee Co. — Specialty Coffee Cardiff, Wales</title>

    <!-- LocalBusiness structured data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CafeOrCoffeeShop",
      "name": "GRINDFATHER Coffee Co.",
      "description": "Specialty coffee roasted to order in Cardiff, Wales. Direct-trade beans, barista-pulled espresso, available weekdays at GymVision and Sundays at Riverside Market.",
      "url": "https://sedaryildirim.github.io/grindfather-coffee-dark-mode/",
      "telephone": "+447464339434",
      "email": "thegrindfathercoffee@gmail.com",
      "servesCuisine": "Coffee",
      "priceRange": "£",
      "currenciesAccepted": "GBP",
      "paymentAccepted": "Cash, Credit Card",
      "areaServed": "Cardiff, Wales",
      "image": "https://sedaryildirim.github.io/grindfather-coffee-dark-mode/images/grindfather-trailer.webp",
      "sameAs": [
        "https://instagram.com/the_grindfather_coffee",
        "https://facebook.com/p/The-Grindfather-Coffee-61575198692256"
      ],
      "location": [
        {
          "@type": "Place",
          "name": "GymVision — Weekdays",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Croescadarn Close, Avenue Industrial Park",
            "addressLocality": "Pentwyn, Cardiff",
            "addressRegion": "Wales",
            "postalCode": "CF23 8HE",
            "addressCountry": "GB"
          },
          "identifier": "ChIJLcsP_7kdbkgRX-_iTMjh2uI",
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": 51.5167,
            "longitude": -3.1167
          },
          "openingHoursSpecification": [
            {
              "@type": "OpeningHoursSpecification",
              "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
              "opens": "06:30",
              "closes": "15:00"
            }
          ]
        },
        {
          "@type": "Place",
          "name": "Riverside Market — Sundays",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Fitzhamon Embankment",
            "addressLocality": "Cardiff",
            "addressRegion": "Wales",
            "postalCode": "CF11 6AN",
            "addressCountry": "GB"
          },
          "identifier": "ChIJMUea0K0cbkgRH1GsQUoL64w",
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": 51.4774,
            "longitude": -3.1846
          },
          "openingHoursSpecification": [
            {
              "@type": "OpeningHoursSpecification",
              "dayOfWeek": ["Sunday"],
              "opens": "10:00",
              "closes": "14:00"
            }
          ]
        }
      ]
    }
    </script>
  </head>
  <body>
    <div id="scroll-progress" aria-hidden="true"></div>
    <a class="skip-link" href="#main">Skip to main content</a>

    <Nav />

    <main id="main">
      <Hero />
      <About />
      <Menu />
      <Location />
      <Contact />
    </main>

    <Footer />

    <button
      id="scroll-top"
      class="scroll-top"
      aria-label="Scroll to top"
      aria-hidden="true"
      tabindex="-1"
    >
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none">
        <path d="M8 13V3M3 8l5-5 5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <script>
      // Scroll-driven animations handle reveals natively in supporting browsers.
      // IO runs only as a fallback for Firefox / reduced-motion.
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const hasSDA = CSS.supports('animation-timeline: scroll()');

      if (!hasSDA || prefersReducedMotion) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
      }

      // Scroll progress + scroll-to-top (single listener)
      const scrollProgress = document.getElementById('scroll-progress');
      const scrollTopBtn = document.getElementById('scroll-top');

      window.addEventListener('scroll', () => {
        const y = window.scrollY;
        const max = document.documentElement.scrollHeight - window.innerHeight;

        if (scrollProgress) {
          scrollProgress.style.transform = `scaleX(${Math.min(y / max, 1)})`;
        }

        if (scrollTopBtn) {
          const visible = y >= 400;
          scrollTopBtn.classList.toggle('scroll-top--visible', visible);
          scrollTopBtn.setAttribute('aria-hidden', String(!visible));
          scrollTopBtn.tabIndex = visible ? 0 : -1;
        }
      }, { passive: true });

      scrollTopBtn?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      // Developer easter egg
      console.log('%cGRINDFATHER', 'font-size:20px;font-weight:900;letter-spacing:6px;color:#fb3640;font-family:sans-serif');
      console.log('%cHand-built in Cardiff. Curiosity welcome.', 'font-size:11px;color:#666;font-family:sans-serif');
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    top: -100%;
    left: 1rem;
    padding: 0.5rem 1rem;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    z-index: 999;
    border-radius: 0 0 4px 4px;
    transition: top 200ms;
  }

  .skip-link:focus {
    top: 0;
  }

  #scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--brick-light);
    transform: scaleX(0);
    transform-origin: left;
    z-index: 200;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    #scroll-progress {
      display: none;
    }
  }

  .scroll-top {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 90;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--brick);
    color: var(--ink);
    border: 1px solid var(--brick);
    cursor: pointer;
    opacity: 0;
    transform: translateY(0.75rem);
    pointer-events: none;
    transition:
      background-color 200ms var(--ease-out-quart),
      border-color 200ms var(--ease-out-quart),
      opacity 250ms var(--ease-out-quart),
      transform 250ms var(--ease-out-quart);
  }

  .scroll-top--visible {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  @media (hover: hover) {
    .scroll-top:hover {
      background-color: var(--brick-deep);
      border-color: var(--brick-deep);
    }
  }

  .scroll-top:active {
    transform: scale(0.9);
  }

  .scroll-top:focus-visible {
    outline: 2px solid var(--paper);
    outline-offset: 4px;
  }

  @media (max-width: 640px) {
    .scroll-top {
      bottom: 1.5rem;
      right: 1.25rem;
    }
  }
</style>
