---
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Menu from '../components/Menu.astro';
import Location from '../components/Location.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="GRINDFATHER Coffee Co. Specialty coffee roasted by ear. Cardiff, Wales. Weekday mornings at GymVision, Sundays at Riverside Market." />
    <meta name="theme-color" content="#000f08" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@900&family=Barlow:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <title>GRINDFATHER Coffee Co. · Specialty Coffee, Cardiff</title>
  </head>
  <body>
    <div id="scroll-progress" aria-hidden="true"></div>
    <a class="skip-link" href="#main">Skip to main content</a>

    <Nav />

    <main id="main">
      <Hero />
      <About />
      <Menu />
      <Location />
      <Contact />
    </main>

    <Footer />

    <button
      id="scroll-top"
      class="scroll-top"
      aria-label="Scroll to top"
      aria-hidden="true"
      tabindex="-1"
    >
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none">
        <path d="M8 13V3M3 8l5-5 5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <script>
      // Scroll-driven animations handle reveals natively in supporting browsers.
      // IO runs only as a fallback for Firefox / reduced-motion.
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const hasSDA = CSS.supports('animation-timeline: scroll()');

      if (!hasSDA || prefersReducedMotion) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
      }

      // Scroll progress
      const scrollProgress = document.getElementById('scroll-progress');
      if (scrollProgress) {
        window.addEventListener('scroll', () => {
          const scrolled = window.scrollY / (document.documentElement.scrollHeight - window.innerHeight);
          scrollProgress.style.transform = `scaleX(${Math.min(scrolled, 1)})`;
        }, { passive: true });
      }

      // Scroll-to-top button
      const scrollTopBtn = document.getElementById('scroll-top');
      if (scrollTopBtn) {
        window.addEventListener('scroll', () => {
          const visible = window.scrollY >= 400;
          scrollTopBtn.classList.toggle('scroll-top--visible', visible);
          scrollTopBtn.setAttribute('aria-hidden', String(!visible));
          scrollTopBtn.tabIndex = visible ? 0 : -1;
        }, { passive: true });
        scrollTopBtn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }

      // Developer easter egg
      console.log('%cGRINDFATHER', 'font-size:20px;font-weight:900;letter-spacing:6px;color:#fb3640;font-family:sans-serif');
      console.log('%cHand-built in Cardiff. Curiosity welcome.', 'font-size:11px;color:#666;font-family:sans-serif');
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    top: -100%;
    left: 1rem;
    padding: 0.5rem 1rem;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    z-index: 999;
    border-radius: 0 0 4px 4px;
    transition: top 200ms;
  }

  .skip-link:focus {
    top: 0;
  }

  #scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--brick-light);
    transform: scaleX(0);
    transform-origin: left;
    z-index: 200;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    #scroll-progress {
      display: none;
    }
  }

  .scroll-top {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 90;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--ink);
    color: var(--paper);
    border: 1px solid var(--ink-border);
    cursor: pointer;
    opacity: 0;
    transform: translateY(0.75rem);
    pointer-events: none;
    transition:
      border-color 200ms var(--ease-out-quart),
      opacity 250ms var(--ease-out-quart),
      transform 250ms var(--ease-out-quart);
  }

  .scroll-top--visible {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  @media (hover: hover) {
    .scroll-top:hover {
      border-color: var(--brick-light);
    }
  }

  .scroll-top:active {
    transform: scale(0.9);
  }

  .scroll-top:focus-visible {
    outline: 2px solid var(--paper);
    outline-offset: 4px;
  }

  @media (max-width: 640px) {
    .scroll-top {
      bottom: 1.5rem;
      right: 1.25rem;
    }
  }
</style>
